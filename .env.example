# Copy to .env locally; never commit real addresses or authorization values.
CHANNEL5_HOST_BIND=127.0.0.1
CHANNEL5_PORT=1996
CHANNEL5_PUBLIC_URL=http://localhost:1996
# Optional metadata alias; leave empty to use PUBLIC_URL/attributes.m3u.
CHANNEL5_METADATA_URL=
# Optional Google DAI event ID, used only if browser capture misses the entry URL.
CHANNEL5_DAI_EVENT=
